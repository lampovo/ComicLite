<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- E-ink: no window animations, every movement leaves ghosting and costs time. -->
    <style name="Eink" parent="@android:style/Theme.Holo.Light.NoActionBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <style name="Eink.Fullscreen" parent="@android:style/Theme.Holo.Light.NoActionBar.Fullscreen">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
